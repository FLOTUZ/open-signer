# ─── Servidor ─────────────────────────────────────────────────────────────────
DOMAIN=localhost
PORT=5000
NODE_ENV=production # en producción la comprobación del efirmas del sat es estricta

# ─── Frontend ─────────────────────────────────────────────────────────────────────
# Opcional. El frontend se compila junto al backend y se sirve desde el mismo
# contenedor/origen, así que por defecto usa la ruta relativa "/api/v1" y no hace
# falta definir esta variable. Solo se usa en BUILD TIME (build-arg de Docker, ver
# docker-compose.yml), no la lee el servidor Node en runtime. Defínela únicamente
# si necesitas que la SPA apunte a un dominio de API distinto al que la sirve.
VITE_API_URL=/api/v1

# ─── Crtificados Root del SAT ───────────────────────────────────────────────────
SAT_CERTS_HOST_DIR=./certs/sat
SAT_CERTS_HASH_FILE=./certs/sat-certs.sha256

# --- CONFIGURACIÓN DE FIRMA Y REVOCACIÓN (SAT) ---
# Directorio donde se encuentran los certificados Raíz/Intermedios del SAT
SAT_CERTS_DIR="/app/certs/sat"

# Modo del Simulador de Verificación de Revocación (Sólo Desarrollo)
# Posibles valores: production, mock_good, mock_revoked, mock_timeout, mock_sat_down, disabled
# En producción DEBE ser "production" o simplemente no existir.
SAT_REVOCATION_CHECK_MODE="production"

# Modo del Simulador de Verificación de Revocación (Sólo Desarrollo)
# Posibles valores: production, mock_good, mock_revoked, mock_timeout, mock_sat_down, disabled
# En producción DEBE ser "production" o simplemente no existir.
SAT_REVOCATION_CHECK_MODE="production"


# ─── Base de Datos ─────────────────────────────────────────────────────────────
# Dentro del contenedor Docker usa host.docker.internal para alcanzar Postgres local.
# En producción (AWS RDS) reemplaza con la URL de tu instancia RDS.
DATABASE_URL="postgresql://postgres:[POSTGRESQL_PASSWORD]@host.docker.internal:5432/opensigner?schema=public"

# ─── Super Admin inicial ────────────────────────────────────────────────────────
# Si la tabla de usuarios está vacía, el primer login auto-crea este usuario
# (rol SUPER_ADMIN, mustChangePassword=true). Cámbialas antes de ir a producción.
SUPER_ADMIN_EMAIL=admin@opensigner.com
SUPER_ADMIN_PASSWORD=admin12345

# ─── JWT / Token de Sesión ─────────────────────────────────────────────────────
# Clave secreta para firmar los tokens HMAC-SHA256 del panel web y los tokens
# temporales de descarga de documentos. Usa un string aleatorio largo en producción.
JWT_SECRET=opensigner-local-fallback-token-secret-key-98765

# ─── Almacenamiento S3-compatible ───────────────────────────────────────────────
# Si estas variables están vacías el sistema usa almacenamiento local (./uploads).
# Cuando estén configuradas, los documentos se suben a S3 (o a un servicio
# S3-compatible) y las URLs de descarga son presigned URLs con TTL de 15 minutos.
#
# En LOCAL/desarrollo: docker-compose ya levanta un contenedor de RustFS
# (S3-compatible, ver servicio "rustfs" en docker-compose.yml) como reemplazo de
# AWS S3. Descomenta AWS_S3_ENDPOINT y AWS_S3_BUCKET, crea el bucket una vez desde
# la consola de RustFS (http://localhost:9011) y listo.
#
# En PRODUCCIÓN: deja AWS_S3_ENDPOINT vacío para usar AWS S3 real.

# Endpoint del servicio S3-compatible (déjalo vacío para usar AWS S3 real).
# Si corres el backend fuera de Docker usa http://localhost:9010 (puerto de host
# mapeado, ver RUSTFS_PORT); si corres el backend dentro de docker-compose usa
# http://rustfs:9000 (nombre del servicio + puerto interno del contenedor).
AWS_S3_ENDPOINT=http://rustfs:9000

# Puertos de host para el contenedor RustFS (cambia si ya tienes otra instancia
# de RustFS/MinIO corriendo en tu máquina en los puertos por defecto).
RUSTFS_PORT=9010
RUSTFS_CONSOLE_PORT=9011

# Región (RustFS/MinIO la ignoran pero el SDK de AWS la requiere; deja us-east-1)
AWS_REGION=us-east-1

# Nombre exacto del bucket (créalo manualmente una vez en la consola S3-compatible o en AWS)
AWS_S3_BUCKET=opensigner

# Credenciales. Con RustFS son las mismas que RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY
# del servicio "rustfs" en docker-compose.yml. En AWS son las de un usuario IAM
# con acceso mínimo al bucket. ¡NUNCA subas estos valores a un repositorio público!
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin

# ─── Almacenamiento Local (fallback sin S3) ────────────────────────────────────
LOCAL_STORAGE_PATH="./uploads"
